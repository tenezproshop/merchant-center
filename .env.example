# Caminho para o JSON da conta de serviço (não commite esse arquivo!)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Alternativa: o conteúdo inteiro do JSON numa variável (tem prioridade sobre o arquivo).
# Use nas variáveis do ambiente do Claude Code na nuvem, nunca aqui no repositório.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ID numérico da conta Merchant Center (aparece no canto superior do painel)
MERCHANT_ID=123456789

# ID da fonte de dados usada nas atualizações (veja: python mc.py datasources)
DATA_SOURCE=
